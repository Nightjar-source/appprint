<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Large screens in dark mode keep the deep expressive container. -->
    <style name="Theme.AppPrint.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_splash_icon_bg_dark</item>
        <item name="windowSplashScreenAnimationDuration">3000</item>
        <item name="postSplashScreenTheme">@style/Theme.AppPrint</item>
    </style>
</resources>
