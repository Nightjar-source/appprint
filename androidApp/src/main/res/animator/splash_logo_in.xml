<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Expressive entrance: lift + rotate into place (M3 emphasized decelerate). -->
    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.80"
        android:valueTo="1.0"
        android:duration="720"
        android:interpolator="@android:interpolator/decelerate_quad" />
    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0.80"
        android:valueTo="1.0"
        android:duration="720"
        android:interpolator="@android:interpolator/decelerate_quad" />
    <objectAnimator
        android:propertyName="rotation"
        android:valueFrom="-10"
        android:valueTo="0"
        android:duration="720"
        android:interpolator="@android:interpolator/decelerate_quad" />
    <objectAnimator
        android:propertyName="alpha"
        android:valueFrom="0.0"
        android:valueTo="1.0"
        android:duration="480" />

    <!-- Subtle living-paper breathing after the entrance, gentle enough for 3 s. -->
    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="1.0"
        android:valueTo="1.035"
        android:startOffset="760"
        android:duration="900"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:interpolator="@android:interpolator/accelerate_decelerate" />
    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="1.0"
        android:valueTo="1.035"
        android:startOffset="760"
        android:duration="900"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:interpolator="@android:interpolator/accelerate_decelerate" />
</set>
