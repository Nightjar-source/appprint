<?xml version="1.0" encoding="utf-8"?>
<!-- «طبعتي» — fully offline: no INTERNET, no ads, no analytics.
     Permissions: camera (فقط لالتقاط صور البطاقات) + إشعارات التصدير (POST_NOTIFICATIONS). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fully offline: no INTERNET, no ads, no analytics. Minimum permissions only:
         camera for capturing card photos. Downloads go via MediaStore on Android 10+
         (permission-free); the legacy File path below needs WRITE_EXTERNAL_STORAGE on 10 and below. -->

    <!-- AdMob (Google Mobile Ads) — needs the internet permission to load ads / test ads.
         TEST App ID until the real AdMob publisher unit is issued: ca-app-pub-3940256099942544~3347511713 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Export completion notification (Android 13+ runtime grant) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Legacy public Downloads path for Android 9 and below only. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppPrint.Splash"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="false">

        <!-- Large screens / foldables: allow tall aspect ratios and continuous resizing. -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />

        <!-- AdMob test App ID (Google's official Android test app) — replace with the real
             publisher App ID when the AdMob account is set up for this application. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppPrint.Splash"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
