<?xml version="1.0" encoding="utf-8"?>
<!-- Clean slate — the app is being rebuilt from scratch from the new design (HTML → Compose).
     Add permissions back per feature (camera / notifications) as they are implemented. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fully offline: no INTERNET permission, no ads, no analytics, no trackers. -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppPrint.Splash"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppPrint"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
